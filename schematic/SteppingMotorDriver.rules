
(rules PCB SteppingMotorDriver.dsn
  (snap_angle 
    fortyfive_degree
  )
  (rule
    (width 200.0)
    (clearance 200.0)
    (clearance -0.1 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 200.0 (type "kicad_default"))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-1]_700:400_um"
    (shape
      (circle F.Cu 700.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 700.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-1]_800:500_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (via 
    "Via[0-1]_700:400_um" "Via[0-1]_700:400_um" default
  )
  (via 
    "Via[0-1]_800:500_um" "Via[0-1]_800:500_um" default
  )
  (via 
    "Via[0-1]_600:300_um-kicad_default" "Via[0-1]_600:300_um" "kicad_default"
  )
  (via 
    "Via[0-1]_700:400_um-kicad_default" "Via[0-1]_700:400_um" "kicad_default"
  )
  (via 
    "Via[0-1]_800:500_um-kicad_default" "Via[0-1]_800:500_um" "kicad_default"
  )
  (via_rule
    default "Via[0-1]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_600:300_um-kicad_default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "/MCU_USB/USB_5V" GNDPWR GND "VIN_24V" +3V3 "/MCU_USB/CHIP_EN" STEP0 DIR0
    STEP1 DIR1 "ENC0_A" "ENC0_B" "ENC1_A" "ENC1_B" STEP2 "/MCU_USB/USB_D-"
    "/MCU_USB/USB_D+" ADC2 "unconnected-(U2-IO46-Pad16)" DIR2 STEP3 DIR3 "DRV_EN" "DRV_RESET"
    "DRV_SLEEP" "ENC2_A" "unconnected-(U2-IO47-Pad24)" "unconnected-(U2-IO48-Pad25)" MS2 "/MCU_USB/BOOT" "ENC2_B" "ENC3_A"
    "ENC3_B" "I2C_SDA" "I2C_SCL" ADC3 MS0 MS1 "unconnected-(U2-RXD0-Pad36)" "unconnected-(U2-TXD0-Pad37)"
    ADC1 ADC0 "unconnected-(A4-FAULT-Pad10)" "Net-(A4-A2)" "Net-(A4-A1)" "Net-(A4-B1)" "Net-(A4-B2)" AIN0
    "Net-(J1-CC2)" "Net-(U7A-+)" "Net-(U7B-+)" "unconnected-(A3-FAULT-Pad10)" "Net-(A3-A2)" "Net-(A3-A1)" "Net-(A3-B1)" "Net-(A3-B2)"
    "Net-(J1-CC1)" AIN3 "Net-(U6A-+)" "Net-(U6B-+)" "Net-(A2-A1)" "Net-(A2-A2)" "Net-(A2-B1)" "Net-(A2-B2)"
    "Net-(C14-Pad1)" "unconnected-(A2-FAULT-Pad10)" "Net-(A1-A1)" "Net-(A1-A2)" "Net-(A1-B1)" "Net-(A1-B2)" AIN2 "/MCU_USB/USB_VBUS"
    "unconnected-(U1-~{FLAG}-Pad4)" "unconnected-(A1-FAULT-Pad10)" "Net-(C11-Pad1)" "Net-(C18-Pad1)" "unconnected-(U3-BP-Pad4)" "/MCU_USB/DN1" AIN1 "Net-(C16-Pad1)"
    "/MCU_USB/DP1" "unconnected-(J1-SBU1-PadA8)" "unconnected-(J1-SBU2-PadB8)"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)